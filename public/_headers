# Cloudflare static-asset headers. Every matching rule applies, so /* sets the security headers
# for everything and the rules below add caching. The build replaces the inline-script placeholder with
# the hashes of the inline scripts in dist/ (scripts/build/post-build.mjs); verify-dist checks them.
#
# style-src needs 'unsafe-inline': the CSS is inlined into each page (astro.config.mjs) and the
# thread layout and Shiki's code colours use style="" attributes.
# HSTS has no includeSubDomains or preload, as planned: one subdomain stays DNS-only, outside Cloudflare.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'inline-script-hashes'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes under its name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names whose content can change: a day fresh, then a week revalidating in the background.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/constantin-metz.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Preview deploys (*.workers.dev) stay out of search results; metz.uk itself is unaffected.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
