---
// A post, in either language. Drafts carry a banner and stay out of search results.
import { render } from "astro:content";

import Page from "../../layouts/Page.astro";
import type { Post } from "../../lib/content";
import { readingMinutes } from "../../lib/content";
import { postNodes } from "../../lib/seo";
import { INTL_LOCALE, otherLocale, postPath, route, type Locale } from "../../i18n/routes";
import { useT } from "../../i18n/ui";

interface Props {
  locale: Locale;
  post: Post;
}

const { locale, post } = Astro.props;
const t = useT(locale);
const entry = post[locale];
const other = otherLocale(locale);
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat(INTL_LOCALE[locale], {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const alternates = { en: postPath(post.en.data.slug, "en"), de: postPath(post.de.data.slug, "de") };
// The name goes in the title when it fits in what search results show; it's in the byline either way.
const withName = `${entry.data.title} · Constantin Metz`;
const title = withName.length <= 65 ? withName : entry.data.title;
const ldNodes = postNodes(post, locale);
---

<Page
  title={title}
  description={entry.data.description}
  locale={locale}
  alternates={alternates}
  section="writing"
  ogType="article"
  noindex={entry.data.draft}
  ld={{
    crumbs: [
      [t("writing.title"), route("writing", locale)],
      [entry.data.title, alternates[locale]],
    ],
    mainEntity: ldNodes[0]["@id"] as string,
    nodes: ldNodes,
  }}>
  <article class="post wrap">
    <header class="post__head">
      <p class="eyebrow">
        <a href={route("writing", locale)}>{t("writing.title")}</a>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="post__desc">{entry.data.description}</p>
      <p class="post__meta">
        <span>Constantin Metz</span>
        <time datetime={entry.data.published.toISOString().slice(0, 10)}>
          {date.format(entry.data.published)}
        </time>
        <span>
          {readingMinutes(entry.body)} {t("writing.minutes")}
        </span>
        <a href={alternates[other]} hreflang={other} lang={other}>
          {t("writing.otherLang")}
        </a>
      </p>
      {entry.data.draft && (
        <p class="post__draft" role="note">
          <span class="badge">{t("writing.draft")}</span>
          {t("writing.draftNote")}
        </p>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post__foot">
      <a class="more" href={route("writing", locale)}>
        {t("writing.all")}
      </a>
    </footer>
  </article>
</Page>

<style>
  .post {
    display: grid;
    /* One column that can't grow past the screen, so long code lines scroll inside their <pre>. */
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
  }
  .post > * {
    width: 100%;
    max-width: var(--prose-max);
  }
  .post__head {
    padding: clamp(48px, 10vh, 120px) 0 clamp(40px, 6vh, 64px);
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--text);
  }
  h1 {
    margin: 18px 0 0;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .post__desc {
    margin: 22px 0 0;
    color: var(--text-2);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--hair);
    color: var(--muted);
    font-size: 14px;
  }
  .post__meta a {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 4px;
  }
  .post__draft {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 24px 0 0;
    padding: 14px 16px;
    border: 1px dashed var(--hair-strong);
    border-radius: 12px;
    color: var(--text-2);
    font-size: 14px;
  }
  .badge {
    padding: 2px 8px;
    border: 1px solid var(--hair-strong);
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .post__foot {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--hair);
  }
</style>
