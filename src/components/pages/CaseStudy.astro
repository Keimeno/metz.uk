---
// A case study, in either language. The header takes the project's station look: its colour, and
// the thread's figure (a still render) or the app itself.
import { render } from "astro:content";

import Page from "../../layouts/Page.astro";
import { publicFileExists } from "../../lib/files";
import { pictureSources } from "../../lib/picture";
import type { Project } from "../../lib/content";
import { projectId, projectNode } from "../../lib/seo";
import { projectAlternates, projectPath, route, type Locale } from "../../i18n/routes";
import { useT, type UiKey } from "../../i18n/ui";
import type { LinkKind } from "../../data/projects";

interface Props {
  locale: Locale;
  project: Project;
  next: Project;
}

const { locale, project, next } = Astro.props;
const t = useT(locale);
const entry = project[locale];
const { def } = project;
const { Content } = await render(entry);
const title =
  locale === "de"
    ? `${entry.data.title}: eine Fallstudie von Constantin Metz`
    : `${entry.data.title}: a case study by Constantin Metz`;

const linkLabel: Record<LinkKind, UiKey> = {
  appStore: "link.appStore",
  site: "link.site",
  live: "link.live",
  repo: "link.repo",
  docs: "link.docs",
  pr: "link.pr",
};

// The header picture: the app (Zenarios), else the thread's still of this station, if rendered.
const still = def.station ? `/media/thread/${def.station}.webp` : null;
const phone = def.media?.find((m) => m.kind === "phone");
const heroSources = phone ? pictureSources(phone.src, phone.width) : [];
const hero = phone
  ? { ...phone, kind: "phone" as const }
  : still && publicFileExists(still)
    ? { kind: "still" as const, src: still, width: 1800, height: 1126 }
    : null;
const heroAlt =
  locale === "de"
    ? hero?.kind === "phone"
      ? `${entry.data.title} auf dem iPhone`
      : `Die Station „${entry.data.title}“ des Threads auf metz.uk`
    : hero?.kind === "phone"
      ? `${entry.data.title} on iPhone`
      : `The ${entry.data.title} station of the thread on metz.uk`;
---

<Page
  title={title}
  description={entry.data.description}
  locale={locale}
  alternates={projectAlternates(def.slug)}
  section="work"
  ogType="article"
  tint={def.tint}
  ld={{
    crumbs: [
      [t("nav.work"), route("work", locale)],
      [entry.data.title, projectPath(def.slug, locale)],
    ],
    about: projectId(def),
    author: true,
    nodes: [projectNode(project, locale)],
  }}>
  <article class="case">
    <header class:list={["case__head wrap", hero && `case__head--${hero.kind}`]}>
      <div class="case__intro">
        <p class="eyebrow">
          <a href={route("work", locale)}>{t("nav.work")}</a>
          <span aria-hidden="true"> / </span>
          {t("work.case")}
        </p>
        <h1>{entry.data.title}</h1>
        <p class="case__headline">{entry.data.headline}</p>
        <dl class="case__meta">
          <div>
            <dt>{t("work.role")}</dt>
            <dd>{entry.data.role}</dd>
          </div>
          <div>
            <dt>{t("work.years")}</dt>
            <dd>{def.years}</dd>
          </div>
          <div class="case__stack">
            <dt>{t("work.stack")}</dt>
            <dd>{entry.data.stack.join(", ")}</dd>
          </div>
          {def.links.length > 0 && (
            <div>
              <dt>{t("work.links")}</dt>
              <dd class="case__links">
                {def.links.map((l) => (
                  <a href={l.href} rel="noopener">
                    {l.label ?? t(linkLabel[l.kind])} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
      {hero ? (
        <figure class:list={["case__hero", `case__hero--${hero.kind}`]}>
          <picture>
            {heroSources.map((s) => (
              <source type={s.type} srcset={s.srcset} sizes="(max-width: 860px) 240px, 300px" />
            ))}
            <img
              src={hero.src}
              width={hero.width}
              height={hero.height}
              alt={heroAlt}
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </figure>
      ) : (
        <div class="case__glow" aria-hidden="true">
          <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet">
            <defs>
              <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                <stop offset="0" stop-color="currentColor" stop-opacity="0.35" />
                <stop offset="1" stop-color="currentColor" stop-opacity="0" />
              </radialGradient>
            </defs>
            <circle cx="200" cy="200" r="190" fill="url(#glow)" />
            <path
              d="M30 250 C 110 250, 120 130, 200 130 S 290 270, 370 150"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
            <circle cx="370" cy="150" r="4" fill="currentColor" />
          </svg>
        </div>
      )}
    </header>

    {entry.data.facts.length > 0 && (
      <ul class="facts wrap">
        {entry.data.facts.map((f) => (
          <li>
            <span class="facts__value">{f.value}</span>
            <span class="facts__label">{f.label}</span>
            {f.note && <span class="facts__note">{f.note}</span>}
          </li>
        ))}
      </ul>
    )}

    <div class="case__body wrap">
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="case__next wrap" aria-label={t("work.next")}>
      <a
        class="case__next-link"
        href={projectPath(next.def.slug, locale)}
        style={`--tint:${next.def.tint}`}>
        <span class="eyebrow">{t("work.next")}</span>
        <span class="case__next-title">{next[locale].data.title}</span>
        <span class="case__next-line">{next[locale].data.headline}</span>
      </a>
      <a class="more" href={route("work", locale)}>
        {t("work.back")}
      </a>
    </nav>
  </article>
</Page>

<style>
  .case__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 48px var(--gutter);
    padding-top: clamp(40px, 9vh, 110px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .case__head--still {
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--text);
  }
  h1 {
    margin: 18px 0 0;
    font-size: clamp(48px, 7.4vw, 112px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  h1::after {
    content: "";
    display: block;
    width: 72px;
    height: 2px;
    margin-top: 28px;
    border-radius: 2px;
    background: var(--tint);
    box-shadow: 0 0 18px var(--tint);
  }
  .case__headline {
    max-width: 30ch;
    margin: 26px 0 0;
    color: var(--text);
    font-size: clamp(21px, 2vw, 28px);
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: balance;
  }
  .case__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 32px;
    max-width: 620px;
    margin: 40px 0 0;
  }
  .case__meta dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .case__meta dd {
    margin: 6px 0 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.5;
  }
  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .case__links a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 4px;
  }
  .case__links a:hover {
    text-decoration-color: var(--tint);
  }

  .case__hero {
    margin: 0;
  }
  .case__hero img {
    display: block;
    width: 100%;
    height: auto;
  }
  .case__hero--phone {
    justify-self: center;
    width: min(300px, 100%);
  }
  .case__hero--phone img {
    border-radius: 13.5% / 6.4%;
    box-shadow:
      0 0 0 1px rgba(237, 235, 230, 0.08),
      0 40px 120px -20px color-mix(in srgb, var(--tint) 40%, transparent);
  }
  /* The still is light on near-black: screen it onto the page so only the light shows. */
  .case__hero--still img {
    mix-blend-mode: screen;
    /* Crush the render's near-black to black, so no rectangle shows. */
    filter: contrast(1.25);
    -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 62%, transparent 100%);
  }
  .case__glow {
    justify-self: center;
    width: min(380px, 100%);
    color: var(--tint);
  }
  .case__glow svg {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 10px var(--tint));
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    margin: 0 auto clamp(56px, 9vh, 96px);
    list-style: none;
  }
  .facts li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 22px 24px 22px 0;
    border-top: 1px solid var(--hair);
  }
  .facts__value {
    color: var(--text);
    font-size: clamp(34px, 3.6vw, 52px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .facts__label {
    color: var(--text-2);
    font-size: 15px;
  }
  .facts__note {
    color: var(--muted);
    font-size: 13px;
  }

  .case__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
  }
  /* Fill the column, never wider: a long code line scrolls inside its <pre>, not the page. */
  .case__body .prose {
    width: 100%;
    min-width: 0;
  }
  @media (min-width: 1100px) {
    .case__body {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    }
    .case__body .prose {
      grid-column: 2;
    }
  }

  .case__next {
    display: grid;
    gap: 28px;
    justify-items: start;
    margin-top: clamp(72px, 12vh, 140px);
  }
  .case__next-link {
    display: grid;
    gap: 10px;
    width: 100%;
    padding: 36px 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
  }
  .case__next-title {
    /* Long German compounds ("Reisekostenrechner") break rather than widen a narrow phone. */
    hyphens: auto;
    overflow-wrap: anywhere;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    transition: color 0.3s ease;
  }
  .case__next-link:hover .case__next-title {
    color: var(--tint);
  }
  .case__next-line {
    color: var(--text-2);
  }

  @media (max-width: 860px) {
    .case__head,
    .case__head--still {
      grid-template-columns: minmax(0, 1fr);
    }
    .case__hero--phone {
      width: min(240px, 70%);
    }
    .case__glow {
      display: none;
    }
    .case__meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
