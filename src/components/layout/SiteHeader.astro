---
// The header on every page but the home page: the name (home), the sections, the language.
import { route, type Alternates, type Locale, type RouteKey } from "../../i18n/routes";
import { useT } from "../../i18n/ui";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  locale: Locale;
  alternates: Alternates | null;
  /** The section this page belongs to. */
  current?: RouteKey;
}

const { locale, alternates, current } = Astro.props;
const t = useT(locale);
const items = [
  { key: "work", label: t("nav.work") },
  { key: "about", label: t("nav.about") },
  { key: "history", label: t("nav.history") },
  { key: "writing", label: t("nav.writing") },
] as const satisfies { key: RouteKey; label: string }[];
---

<header class="site-header">
  <a class="site-header__mark" href={route("home", locale)}>Constantin Metz</a>
  <nav class="site-header__nav" aria-label={t("nav.label")}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={route(item.key, locale)} aria-current={item.key === current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <LangSwitch locale={locale} alternates={alternates} class="site-header__lang" />
</header>

<style>
  .site-header {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px 28px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: calc(22px + env(safe-area-inset-top)) var(--gutter) 22px;
  }
  .site-header__mark {
    font-size: 15px;
    font-weight: 560;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .site-header__nav ul {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current] {
    color: var(--text);
  }
  .site-header__nav a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 6px;
  }
  @media (max-width: 640px) {
    .site-header {
      grid-template-columns: 1fr auto;
    }
    .site-header__nav {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .site-header__nav ul {
      justify-content: flex-start;
      gap: 6px 20px;
    }
  }
</style>
