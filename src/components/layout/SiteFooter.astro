---
// The footer on every page: how to reach him, where else he is, the rest of the site.
import { PERSON } from "../../data/person";
import { route, rssPath, type Alternates, type Locale } from "../../i18n/routes";
import { useT } from "../../i18n/ui";
import LangSwitch from "./LangSwitch.astro";
import Email from "../ui/Email.astro";

interface Props {
  locale: Locale;
  alternates: Alternates | null;
}

const { locale, alternates } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__contact">
      <p class="site-footer__name">Constantin Metz</p>
      <p class="site-footer__role">{t("site.role")}</p>
      <Email class="site-footer__email" locale={locale} />
    </div>
    <nav class="site-footer__cols" aria-label={t("footer.site")}>
      <div>
        <p class="eyebrow">{t("footer.elsewhere")}</p>
        <ul>
          {
            PERSON.profiles.map((p) => (
              <li>
                <a href={p.href} rel="me noopener">
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">{t("footer.site")}</p>
        <ul>
          <li><a href={route("work", locale)}>{t("nav.work")}</a></li>
          <li><a href={route("about", locale)}>{t("nav.about")}</a></li>
          <li><a href={route("history", locale)}>{t("nav.history")}</a></li>
          <li><a href={route("writing", locale)}>{t("nav.writing")}</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="site-footer__base">
    <span>© {year} Constantin Metz</span>
    <span class="site-footer__legal">
      <a href={route("imprint", locale)}>{t("footer.imprint")}</a>
      <a href={route("privacy", locale)}>{t("footer.privacy")}</a>
      <a href={rssPath(locale)}>{t("footer.rss")}</a>
      <LangSwitch locale={locale} alternates={alternates} size="long" />
    </span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter) calc(28px + env(safe-area-inset-bottom));
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px var(--gutter);
    padding: 72px 0 64px;
    border-top: 1px solid var(--hair);
  }
  .site-footer__name {
    margin: 0;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .site-footer__role {
    margin: 8px 0 28px;
    color: var(--muted);
  }
  .site-footer__email {
    font-size: clamp(17px, 1.5vw, 20px);
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 6px;
    transition: text-decoration-color 0.25s ease;
  }
  .site-footer__email:hover {
    text-decoration-color: var(--text);
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .site-footer__cols ul {
    display: grid;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__cols a {
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .site-footer__cols a:hover {
    color: var(--text);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    color: var(--muted);
    font-size: 13px;
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .site-footer__legal a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .site-footer__legal a:hover {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      padding: 56px 0 48px;
    }
  }
</style>
