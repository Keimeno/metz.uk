---
// His email address, kept out of the page source so scrapers don't harvest it. The HTML never holds
// the address: no "@", no mailto:, and not even the whole address in one piece. The two halves sit
// reversed in two attributes, and CSS draws them the right way round (a bidi override), with the
// "@" coming from the stylesheet. Copying, Reader mode and text extraction never get the address.
// The first real interaction (a pointer, a key, a touch, focus, or a click from a screen reader
// that sends nothing else) turns every address on the page into a plain mailto: link before the
// click lands. Without JavaScript it still reads correctly and links to the imprint. Any content
// passed in goes before the address, inside the link.
import { PERSON } from "../../data/person";
import { route, type Locale } from "../../i18n/routes";
import { useT } from "../../i18n/ui";

interface Props {
  locale: Locale;
  class?: string;
  address?: string;
}

// The rest carries the parent's scoped-style attribute, so `class` can be styled from there.
const { locale, class: className, address = PERSON.email, ...rest } = Astro.props;
const t = useT(locale);
const reverse = (s: string) => [...s].reverse().join("");
const [local, host] = address.split("@");
---

<a
  class:list={["email", className]}
  href={route("imprint", locale)}
  aria-label={t("email.label")}
  data-email
  {...rest}>
  <slot />
  <span
    class="email__addr"
    data-u={reverse(local)}
    data-h={reverse(host)}
    aria-hidden="true"></span>
</a>

<script>
  const reverse = (s: string) => [...s].reverse().join("");
  const upgrade = () => {
    for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-email]")) {
      const addr = a.querySelector<HTMLElement>("[data-u]");
      if (!addr?.dataset.u || !addr.dataset.h) continue;
      const email = `${reverse(addr.dataset.u)}@${reverse(addr.dataset.h)}`;
      addr.textContent = email;
      addr.removeAttribute("data-u");
      addr.removeAttribute("data-h");
      addr.removeAttribute("aria-hidden");
      a.href = `mailto:${email}`;
      a.removeAttribute("aria-label");
      a.removeAttribute("data-email");
    }
  };
  // "click" last: it is still in time, since a link follows its href only after the click event.
  const events = [
    "pointermove",
    "pointerdown",
    "touchstart",
    "keydown",
    "focusin",
    "click",
  ] as const;
  const once = () => {
    for (const e of events) removeEventListener(e, once, true);
    upgrade();
  };
  for (const e of events) addEventListener(e, once, { capture: true, passive: true });
</script>

<style>
  .email__addr[data-u]::before {
    content: attr(data-h) "\0040" attr(data-u);
    unicode-bidi: bidi-override;
    direction: rtl;
  }
</style>
